# Copy to .env for Docker Compose. Never commit .env.
# Compose connects the app to its Ollama service automatically.
USIPHU_OLLAMA_MODEL=qwen2.5:7b

# For running the app directly on the host (outside Compose), use:
# OLLAMA_BASE_URL=http://localhost:11434

# Optional NCBI contact/rate-limit credentials for PubMed E-utilities.
NCBI_EMAIL=
NCBI_API_KEY=
